{
  "openapi": "3.0.0",
  "info": {
    "title": "Expense Management System API",
    "description": "A comprehensive REST API for managing company expenses with multi-tenant support, role-based access control, and audit logging.",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@expensemanagement.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Development Server"
    },
    {
      "url": "https://api.expensemanagement.com/api",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new company and admin user",
        "description": "Creates a new company and registers the first admin user. This endpoint has rate limiting of 3 requests per minute.",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "password_confirmation", "company_name", "company_email"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Full name of the admin user",
                    "example": "John Doe",
                    "minLength": 2,
                    "maxLength": 255
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address of the admin user",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password for the admin user (at least 8 characters)",
                    "example": "SecurePassword123!",
                    "minLength": 8
                  },
                  "password_confirmation": {
                    "type": "string",
                    "format": "password",
                    "description": "Password confirmation (must match password)",
                    "example": "SecurePassword123!"
                  },
                  "company_name": {
                    "type": "string",
                    "description": "Name of the company",
                    "example": "ACME Corporation",
                    "minLength": 2,
                    "maxLength": 255
                  },
                  "company_email": {
                    "type": "string",
                    "format": "email",
                    "description": "Company email address",
                    "example": "contact@acme.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Company and admin user created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Admin user for the company registered successfully"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/UserResource"
                        },
                        "token": {
                          "type": "string",
                          "description": "API access token for authentication",
                          "example": "1|abcdefghijklmnopqrstuvwxyz"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Validation failed"
                    },
                    "errors": {
                      "type": "object",
                      "example": {
                        "email": ["The email has already been taken."],
                        "company_email": ["The company email has already been taken."]
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (rate limited: 3 per minute)"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login and get API token",
        "description": "Authenticates a user and returns an API access token. This endpoint has rate limiting of 5 requests per minute.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "User email address",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "User password",
                    "example": "SecurePassword123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Login successful"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "API access token for authentication",
                          "example": "1|abcdefghijklmnopqrstuvwxyz"
                        },
                        "user": {
                          "$ref": "#/components/schemas/UserResource"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid credentials"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Too many requests (rate limited: 5 per minute)"
          }
        }
      }
    },
    "/expenses": {
      "get": {
        "tags": ["Expenses"],
        "summary": "List all expenses for the authenticated user's company",
        "description": "Retrieves a paginated list of expenses with optional search and relationship includes. Only expenses from the user's company are returned.",
        "operationId": "listExpenses",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination (default: 1)",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search expenses by title or category",
            "schema": {
              "type": "string",
              "example": "Office Supplies"
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Include related resources. Options: user, company. Multiple values separated by comma.",
            "schema": {
              "type": "string",
              "enum": ["user", "company", "user,company"],
              "example": "user,company"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of expenses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ExpenseResource"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "tags": ["Expenses"],
        "summary": "Create a new expense",
        "description": "Creates a new expense for the authenticated user's company.",
        "operationId": "createExpense",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "amount", "category"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Expense title/description",
                    "example": "Office Supplies",
                    "minLength": 3,
                    "maxLength": 255
                  },
                  "amount": {
                    "type": "number",
                    "format": "float",
                    "description": "Expense amount in company currency",
                    "example": 150.50,
                    "minimum": 0.01
                  },
                  "category": {
                    "type": "string",
                    "description": "Expense category",
                    "example": "Supplies",
                    "minLength": 2,
                    "maxLength": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Expense created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Expense created successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ExpenseResource"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/expenses/{expenseId}": {
      "put": {
        "tags": ["Expenses"],
        "summary": "Update an existing expense",
        "description": "Updates an expense. Only the owner of the expense or company admins can update it.",
        "operationId": "updateExpense",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "expenseId",
            "in": "path",
            "required": true,
            "description": "ID of the expense to update",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Expense title/description",
                    "example": "Updated Office Supplies",
                    "minLength": 3,
                    "maxLength": 255
                  },
                  "amount": {
                    "type": "number",
                    "format": "float",
                    "description": "Expense amount",
                    "example": 175.75,
                    "minimum": 0.01
                  },
                  "category": {
                    "type": "string",
                    "description": "Expense category",
                    "example": "Supplies",
                    "minLength": 2,
                    "maxLength": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Expense updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Expense updated successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ExpenseResource"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - User does not have permission to update this expense"
          },
          "404": {
            "description": "Expense not found"
          },
          "422": {
            "description": "Validation error"
          }
        }
      },
      "delete": {
        "tags": ["Expenses"],
        "summary": "Delete an expense",
        "description": "Deletes an expense. Only company admins can delete expenses.",
        "operationId": "deleteExpense",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "expenseId",
            "in": "path",
            "required": true,
            "description": "ID of the expense to delete",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Expense deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Expense deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Only admins can delete expenses"
          },
          "404": {
            "description": "Expense not found"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List all users in the authenticated user's company",
        "description": "Retrieves a paginated list of users in the company. Only company admins can view all users.",
        "operationId": "listUsers",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination (default: 1)",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Include related resources. Options: company, expenses. Multiple values separated by comma.",
            "schema": {
              "type": "string",
              "enum": ["company", "expenses", "company,expenses"],
              "example": "company,expenses"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UserResource"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Only admins can view users"
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a new user",
        "description": "Creates a new user in the company. Only company admins can create users.",
        "operationId": "createUser",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "password_confirmation", "role"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Full name of the user",
                    "example": "Jane Smith",
                    "minLength": 2,
                    "maxLength": 255
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address (must be unique within company)",
                    "example": "jane@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password (at least 8 characters)",
                    "example": "SecurePassword123!",
                    "minLength": 8
                  },
                  "password_confirmation": {
                    "type": "string",
                    "format": "password",
                    "description": "Password confirmation (must match password)",
                    "example": "SecurePassword123!"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["Admin", "Employee"],
                    "description": "User role within the company",
                    "example": "Employee"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "User created successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserResource"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Only admins can create users"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/users/{userId}": {
      "put": {
        "tags": ["Users"],
        "summary": "Update a user's role",
        "description": "Updates a user's role. Only the user themselves or company admins can update roles.",
        "operationId": "updateUser",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "ID of the user to update",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": ["Admin", "Employee"],
                    "description": "New user role",
                    "example": "Admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "User role updated successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserResource"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - User does not have permission to update this user"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/logs": {
      "get": {
        "tags": ["Audit Logs"],
        "summary": "List audit logs for the company",
        "description": "Retrieves paginated audit logs of all changes in the company. Only admins can view logs.",
        "operationId": "listLogs",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination (default: 1)",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of audit logs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuditLog"
                      }
                    },
                    "links": {
                      "$ref": "#/components/schemas/PaginationLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Only admins can view logs"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserResource": {
        "type": "object",
        "description": "User resource with optional relationships",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "role": {
            "type": "string",
            "enum": ["Admin", "Employee"],
            "example": "Admin"
          },
          "company_id": {
            "type": "integer",
            "example": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-27T12:34:56.000000Z"
          },
          "company": {
            "$ref": "#/components/schemas/CompanyResource",
            "description": "Only included when ?include=company is passed"
          },
          "expenses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseResource"
            },
            "description": "Only included when ?include=expenses is passed"
          }
        }
      },
      "CompanyResource": {
        "type": "object",
        "description": "Company resource with optional relationships",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "ACME Corporation"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "contact@acme.com"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResource"
            },
            "description": "Only included when ?include=users is passed"
          },
          "expenses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseResource"
            },
            "description": "Only included when ?include=expenses is passed"
          }
        }
      },
      "ExpenseResource": {
        "type": "object",
        "description": "Expense resource with optional relationships",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Office Supplies"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 150.50
          },
          "category": {
            "type": "string",
            "example": "Supplies"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-27T12:34:56.000000Z"
          },
          "user": {
            "$ref": "#/components/schemas/UserResource",
            "description": "Only included when ?include=user is passed"
          },
          "company": {
            "$ref": "#/components/schemas/CompanyResource",
            "description": "Only included when ?include=company is passed"
          }
        }
      },
      "AuditLog": {
        "type": "object",
        "description": "Audit log entry",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "action": {
            "type": "string",
            "enum": ["created", "updated", "deleted"],
            "example": "updated"
          },
          "model": {
            "type": "string",
            "enum": ["Expense", "User"],
            "example": "Expense"
          },
          "model_id": {
            "type": "integer",
            "example": 5
          },
          "user_id": {
            "type": "integer",
            "example": 1
          },
          "company_id": {
            "type": "integer",
            "example": 1
          },
          "changes": {
            "type": "object",
            "description": "What was changed (old_value => new_value)",
            "example": {
              "amount": {
                "old": 150.00,
                "new": 175.75
              },
              "title": {
                "old": "Office Supplies",
                "new": "Updated Office Supplies"
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-27T12:34:56.000000Z"
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "format": "uri",
            "example": "http://localhost:8000/api/expenses?page=1"
          },
          "last": {
            "type": "string",
            "format": "uri",
